apiVersion: operator.dataverse.redhat.com/v1alpha1
kind: FivetranConnector
metadata:
  name: {{.Name}}
  namespace: {{.Namespace}}
spec:
  connector:
    group_id: "{{.GroupID}}"
    service: fivetran_log
    paused: true
    schedule_type: auto
    sync_frequency: 1440
    daily_sync_time: "21:00"
    run_setup_tests: false
    config:
      is_account_level_connector: false
      schema: "{{.Schema}}"
